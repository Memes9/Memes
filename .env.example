# ---- GoldBridge configuration ----
# نهێنی وێبهۆکی TradingView (هەمان شت لە ناو ئەلێرتەکەدا بنووسە)
TV_WEBHOOK_SECRET=change-me-tradingview-secret

# تۆکنی EA / Executor بۆ پەیوەندی بە سێرڤەرەوە
EA_TOKEN=change-me-ea-token

# وشەی نهێنی داشبۆرد (بۆ کردنەوەی ڕووکار)
DASHBOARD_TOKEN=change-me-dashboard-token

# ڕێگەپێدراوی سیمبولەکان (بە کۆما جیا بکەرەوە) - بەتاڵ = هەموویان
ALLOWED_SYMBOLS=XAUUSD,XAUUSD.m,GOLD,XAUUSDm

HOST=0.0.0.0
PORT=8000
DB_PATH=data/goldbridge.db
